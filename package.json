{
  "name": "subtrack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "server": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "test:core": "npm --prefix packages/sync-core test",
    "typecheck:core": "npm --prefix packages/sync-core run typecheck",
    "sim": "npm --prefix sim run sim --",
    "test:sim": "npm --prefix sim test",
    "typecheck:sim": "npm --prefix sim run typecheck",
    "case-study": "npm --prefix sim run case-study"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "typescript": "^5.3.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "overrides": {
    "@react-navigation/native": "~7.0.14",
    "@react-navigation/native-stack": "~7.2.0",
    "@react-navigation/bottom-tabs": "~7.2.0",
    "@react-navigation/elements": "~2.2.5",
    "@react-navigation/core": "~7.3.1",
    "@react-navigation/routers": "~7.1.2"
  }
}
